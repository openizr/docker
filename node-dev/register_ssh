#!/bin/sh

# Strict error handling.
set -eu

# Key comes from stdin: an argument would leak into `ps`, shell history and `docker inspect`.
if [ "$#" -ne 0 ] || [ -t 0 ]; then
  echo "Usage: register_ssh < path/to/private_key" >&2
  exit 1
fi

KEY_CONTENT="$(cat)"
if [ -z "$KEY_CONTENT" ]; then
  echo "register_ssh: empty key" >&2
  exit 1
fi

# `id_rsa` is kept as the file name because ssh looks it up by default and
# reads the actual key type from the content.
KEY="$HOME/.ssh/id_rsa"

# Files are created private from the start, no window before a `chmod`.
umask 077
mkdir -p "$HOME/.ssh"
# `>` keeps a stale file's mode and follows symlinks, so start from a fresh file.
rm -f "$KEY"
# `%b` expands `\n` sequences, so single-line keys from env vars work too.
printf '%b\n' "$KEY_CONTENT" > "$KEY"
echo "Successfully registered SSH key"
