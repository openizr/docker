#!/bin/sh

# Strict error handling.
set -eu

if [ "$#" -ne 2 ]; then
  echo "Usage: dsync <source> <destination>" >&2
  exit 1
fi

# No `-z`: compression is useless between local paths.
# Keep looping on failure, but say so: a silent broken sync looks healthy.
sync() { rsync -aq --delete "$1" "$2" || echo "dsync: sync failed (rsync exit $?)" >&2; }

# Synchronizes 2 directories or files in real time.
while true; do
  if [ -e "$1" ]; then
    # First copy, so we do not wait for a change before syncing.
    sync "$1" "$2"
    # `-m` keeps watches alive while rsync runs: events are queued, not lost.
    # `close_write` instead of `modify`: never copy half-written files.
    inotifywait -m -r -q -e close_write,create,delete,move "$1" | while read -r _; do
      # Debounce: drain the burst for 200ms, then sync once.
      while read -r -t 0.2 _; do :; done
      sync "$1" "$2"
    done
  fi
  sleep 3
done
